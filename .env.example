# =============================================================================
# Review Insights Dashboard — Environment Configuration Example
# Copy this file to .env for local development (`cp .env.example .env`)
# Never commit real credentials or production secrets to git.
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=review_insights
POSTGRES_PORT=54320

# --- Backend API (apps/api) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:54320/review_insights
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54320/review_insights_test
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_IMPORTS=10

# --- Frontend Web (apps/web) ---
VITE_API_URL=http://localhost:4000/api/v1
